{
  "version": 1,
  "purpose": "User-supplied full-screen evidence for Reborn WoW state recognition, replay, and later dry-run action verification.",
  "scope": "Catalog only. These assets are not yet part of tools/run_replay.py's P0-B gatekeeper manifest.",
  "global_rules": {
    "exit_game": {
      "state": "ANY_IN_GAME_STATE",
      "target": "top_left_exit_game",
      "input": "left_click",
      "guard": "Only after the runner has decided to stop or exit; never use it as a recovery guess."
    },
    "great_rift": {
      "preconditions": [
        "All map challenges are complete.",
        "No active boss remains on the map.",
        "The upper-left Hero Challenge indicator is visible."
      ],
      "absence_rule": "If Hero Challenge is absent, Great Rift is not considered open and no Great Rift input is allowed."
    }
  },
  "assets": [
    {
      "id": "room_waiting_host",
