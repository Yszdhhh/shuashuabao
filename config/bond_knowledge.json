  "bond_priority": {
    "_comment": "羁绊默认取卡顺序。实验室白名单按 round1 → 属性链(含末环UR) → round2 → must_take → round4 → 该系 support 拼出来；「差 1 张吞噬」仍然压过全部顺序。名字都是游戏内规范名。来源：抖音基础卡组攻略（无胆超人5月/在家零四一7月，user 20260813 转述）+ user 实机复盘调序。",
    "round1_must": [
      "祝福",
      "成长",
      "经济",
      "贪婪",
      "挑战"
    ],
    "round1_note": "第一轮前必须做完。贪婪是必拿不是选做：套装随机吞食 4 张可吞食卡牌，另给 150 木 + 888 杀敌 + 6000 金币，吞食丹不多时尤其关键。",
    "round2_attr_chain": "见 attr_routes.chain（含末环 UR）。**整条链排在 round2_survival 之前**：user 20260813 实机指出「有湮灭者却先去拿体术」——UR 是整条链的产出，体术这类通用生存卡全程都能补，不该压过它。",
    "round3_survival": [
      "提速",
      "体术",
      "固守",
      "陷阵"
    ],
    "round3_note": "生存 + 破甲。体术破甲 10% 优先级极高；提速是体术/固守/生命的前置。",
    "must_take": [
      "急速"
    ],
    "must_take_note": "user 20260813：技能急速出了基本就是必选项，优先级明显高于同为法术衍生的魔能/魔术（那两张才是可选）。上一版重构 bond_priority 时把急速整个漏出了白名单，这里补回并单列一层。",
    "round4_optional": [
      "生命",
      "血势",
      "血魔",
      "暴击",
      "致命",
      "大炮"
    ],
    "round4_note": "正式长局、木头富余再做。暴击套需暴击率>50% 才是正收益；大炮配龙族。",
    "lab_skip": [
      "生命",
      "血势",
      "血魔",
      "暴击",
      "致命",
      "大炮"
    ],
    "lab_skip_note": "实验室只采 UR 链。trace 172349 敏捷 G2 在门卡凑齐前就拿了暴击/致命/大炮，格子和木头被选做吃掉，后面整晚在刷箭术/战术。这些卡正式局仍留在 round4。",
    "not_recommended": [
      "剑术"
    ],
    "not_recommended_note": "剑术是普攻剑气流专属，其他流派没用；不进白名单。"
  },
